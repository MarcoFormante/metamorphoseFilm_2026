{% extends 'base.html.twig' %}

{% block title %}À propos{% endblock %}

{% block meta %}
    {% set pageDescription = "Découvrez l'équipe créative de Métamorphose Film : Thibaud Richard, Napy et Vincent Pauly. Passionnés de réalisation, cadrage, montage et photographie." %}

    <meta name="description" content="{{ pageDescription }}">
    <meta name="keywords" content="équipe metamorphose film, thibaud richard, napy, vincent pauly, réalisateur, cadreur, monteur, photographe corporate">
    <meta name="robots" content="index, follow">

    <meta property="og:title" content="À Propos de Nous - Metamorphose Film">
    <meta property="og:type" content="profile">
    <meta property="og:url" content="{{ app.request.getUri() }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:image" content="{{asset('static/images/og-preview.jpg')}}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="À Propos de Nous - Metamorphose Film">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "mainEntity": {
        "@type": "Organization",
        "name": "Metamorphose Film",
        "url": "https://metamorphosefilm.com",
        "logo": "{{ app.request.getSchemeAndHttpHost() ~ asset('static/images/og-preview.jpg')}}",
        "sameAs": [
          "https://www.instagram.com/metamorphosefilm/",
          "https://www.linkedin.com/company/metamorphose-film/"
        ],
        "employee": [
          {
            "@type": "Person",
            "name": "Thibaud RICHARD",
            "jobTitle": "Réalisateur, Cadreur, Monteur, Effets Spéciaux",
            "sameAs": "https://www.instagram.com/thibaud.richard/"
          },
          {
            "@type": "Person",
            "name": "NAPY",
            "jobTitle": "Réalisateur, Photographe, Étalonneur, Pilote de Drone",
            "sameAs": "https://www.instagram.com/napy.video/"
          },
          {
            "@type": "Person",
            "name": "Vincent PAULY",
            "jobTitle": "Réalisateur, Cadreur, Monteur, Storyboarder",
            "sameAs": "https://www.instagram.com/vincii_pauly/"
          }
        ]
      }
    }
    </script>
{% endblock %}

{% block body %}
<main class="about main-padding title-mobile-center" >
    <twig:pageTitle title1="À Propos" title2="" />
    <p class="about-desc">Tout a commencé avec 3 esprits créatifs et passionnés, qui ont uni leurs forces pour donner naissance à une aventure unique.</p>

    <div class="about-person-cards" data-controller="cards">
        <div class="about-person-container">
            <a aria-label="Profile instagram de Thibaud RICHARD" href="https://www.instagram.com/thibaud.richard/">
                <div class="about-person">
                    <figure>
                        <img src="\static\images\thibaud-metamorphose.webp" alt="Thibaud RICHARD - Réalisation et Montage chez Metamorphose film">
                    </figure>
                    <div>
                        <p class="person-name person-text">Thibaud RICHARD</p>
                        <ul class="person-job-list">
                            <li class="person-job person-text">RÉALISATION</li>
                            <li class="person-job person-text">CADRAGE</li>
                            <li class="person-job person-text">MONTAGE</li>
                            <li class="person-job person-text">EFFETS SPECIAUX</li>
                        </ul> 
                    </div>
                </div>
            </a>
        </div>

        <div class="about-person-container about-person-container-reverse">
            <a aria-label="Profile instagram de Napy" href="https://www.instagram.com/napy.video/">
                <div class="about-person">
                    <figure>
                        <img src="\static\images\napy-metamorphose-web.webp" alt="Napy - Réalisation, Photographie et Drone chez Metamorphose film">
                    </figure>
                    <div>
                        <p class="person-name person-text">NAPY</p>
                        <ul class="person-job-list">
                            <li class="person-job person-text">RÉALISATION</li>
                            <li class="person-job person-text">PHOTOGRAPHIE</li>
                            <li class="person-job person-text">ÉTALONNAGE</li>
                            <li class="person-job person-text">PILOTAGE</li>
                            <li class="person-job person-text">DRONE</li>
                        </ul> 
                    </div>
                </div>
            </a>
        </div>

        <div class="about-person-container">
            <a aria-label="Profile instagram de Vincent PAULY" href="https://www.instagram.com/vincii_pauly/">
                <div class="about-person">
                    <figure>
                        <img src="\static\images\vincent-metamorphose.webp" alt="Vincent PAULY - Réalisation e Storyboard chez Metamorphose film">
                    </figure>
                    <div>
                        <p class="person-name person-text">Vincent PAULY</p>
                         <ul class="person-job-list">
                            <li class="person-job person-text">RÉALISATION</li>
                            <li class="person-job person-text">CADRAGE</li>
                            <li class="person-job person-text">MONTAGE</li>
                            <li class="person-job person-text">STORYBOARD</li>
                        </ul>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="about-person-cards-mobile">
        <ul class="cards-list" data-controller="cards">
            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <figure>
                                <figcaption class="person-name person-text">Thibaud RICHARD</figcaption>
                                <img src="\static\images\thibaud-metamorphose.webp" alt="Thibaud RICHARD - Metamorphose film">
                            </figure>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <ul class="person-job-list">
                                <li class="person-job person-text">RÉALISATION</li>
                                <li class="person-job person-text">CADRAGE</li>
                                <li class="person-job person-text">MONTAGE</li>
                                <li class="person-job person-text">EFFETS SPECIAUX</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>
           
            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <figure>
                                <figcaption class="person-name person-text">Napy</figcaption>
                                <img src="\static\images\napy-metamorphose-web.webp" alt="Napy - Metamorphose film">
                            </figure>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <ul class="person-job-list">
                                <li class="person-job person-text">RÉALISATION</li>
                                <li class="person-job person-text">PHOTOGRAPHIE</li>
                                <li class="person-job person-text">ÉTALONNAGE</li>
                                <li class="person-job person-text">PILOTAGE DRONE</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>

            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <figure>
                                <figcaption class="person-name person-text">Vincent PAULY</figcaption>
                                <img src="\static\images\vincent-metamorphose.webp" alt="Vincent PAULY - Metamorphose film">
                            </figure>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <ul class="person-job-list">
                                <li class="person-job person-text">RÉALISATION</li>
                                <li class="person-job person-text">CADRAGE</li>
                                <li class="person-job person-text">MONTAGE</li>
                                <li class="person-job person-text">STORYBOARD</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>
        </ul>
    </div>

    <h2 class="bigTitle">Contact</h2>
    <div class="about-contact-desc-container">
        <p class="about-contact-desc"> Si vous souhaitez passer une commande, établir un partenariat, formuler une demande ou simplement obtenir des informations,</p>
        <p class="about-contact-desc">Metamorphose est à votre service afin de répondre à votre demande dans les plus brefs délais !</p>
    </div>
    <div class="about-contact-container">
        <ul>
            <li><a href="https://www.instagram.com/metamorphosefilm/" class="about-contact-insta">Instagram {% include "_partials/instagram.html.twig" %}</a></li>
            <li><a href="mailto:metamorphoseproduction@gmail.com" class="about-contact-email"> <span>Email</span>  {% include "_partials/email.html.twig" %}</a></li>
            <li><a href="https://www.linkedin.com/company/metamorphose-film/" class="about-contact-linkedin">Linkedin {% include "_partials/linkedin.html.twig" %}</a></li>
        </ul>
    </div>
</main>
{% endblock %}