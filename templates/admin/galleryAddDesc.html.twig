{% extends 'admin_base.html.twig' %}

{% block title %}Admin gallery Ajoute Description{% endblock %}

{% block body %}
    <main class="admin-page admin-gallery-add-desc">
           <div class="admin-header">
            <div class="flex-row gap-10">
                <a href="/admin/logout">Logout</a>
                <a href="/admin/galleries/{{galleryName|lower}}">Precedent</a>
            </div>
        </div>
        {% if images %}
        <div class="add-desc-images-container">
            {% for img in images %}
                <img src="/uploads/images/galleries/{{img.src}}" alt="">
            {% endfor %}
        </div>
        {% endif %}
        
       {{form_start(form)}}
       {{form_widget(form)}}
        <input type="submit" value="Sauvegarder">
       {{form_end(form)}}
       
    </main>

{% endblock %}
