{% extends 'admin_base.html.twig' %}

{% block title %}Admin gallery{% endblock %}

{% block body %}
    <main class="admin-page admin-gallery-images" data-controller="images">
        
        <div class="admin-header">
            <div class="flex-row gap-10">
                <a href="/admin/logout">Logout</a>
                <a href="/admin/galleries">Precedent</a>
            </div>
            <a href="/admin/gallery/{{galleryName|lower}}/add-images">Ajouter les images</a>
            <a class="admin-gallery-add-desc-btn hidden" href="/admin/gallery/add-desc?">Modifier Description</a>
        </div>
         <h1>Galerie {{galleryName}}</h1>
         <button data-selected="false" class="admin-gallery-mod-btn">Modalité Selection</button>
         <div class="admin-gallery">
            {% if images is defined %}
                {% for img in images %}
                    <div data-description="{{img.description}}">
                        <img draggable="true" data-id="{{img.id}}" data-position="{{img.position}}"   src="{{asset('/uploads/images/galleries/' ~ img.src)}}" alt="" width="200" height="250"/>
                        <button data-id='{{img.id}}' data-name="{{img.galleryName}}" class="delete-button">Effacer</button>
                    </div>
                {% endfor %}
                    

        {% endif %}
         </div>
         {% if images is defined and images is empty %}
                <p class="text-center font-large">Il n'y a pas d'image</p>
        {% endif %}

        {% if images is defined %}
             {# form to change image position #}
                <div class="hidden">
                    {{form_start(form)}}
                    {{form_end(form)}}
                </div>

                {# form to delete a image #}
                <div class="hidden">
                    {{form_start(deleteForm)}}
                    {{form_end(deleteForm)}}
                </div>  
        {% endif %}
    </main>

{% endblock %}
