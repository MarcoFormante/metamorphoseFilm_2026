<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta http-equiv="content-language" content="fr">
        <meta name="theme-color" content="#000000">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes"> 
        <meta name="author" content="MetamorphoseFilm">
        <meta name="copyright" content="Metamorphose Film">
        
        <link rel="canonical" href="{{ app.request.getUri() }}">

        <meta property="og:site_name" content="MetamorphoseFilm">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:image" content="https://metamorphosefilm.com/static/images/og-preview.jpg">
        <meta property="og:image:alt" content="MetamorphoseFilm">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:creator" content="MetamorphoseFilm">
        <meta name="twitter:image" content="https://metamorphosefilm.com/static/images/og-preview.jpg">

        {% block meta %}
        <meta name="description" content="Société de production audiovisuelle créative, Metamorphose conçoit des contenus multimédias divers et variés, alliant originalité artistique et narration visuelle cinématographique.">
        <meta name="keywords" content="vidéo, montage, audiovisuel, cinéma, clip musical, réalisation, photographie, artiste, étalonnage, drone, metamorphose, metamorphosefilm">
        <meta name="robots" content="index, follow">

        <meta property="og:title" content="MetamorphoseFilm">
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://metamorphosefilm.com">
        <meta property="og:description" content="Société de production audiovisuelle créative, Metamorphose conçoit des contenus multimédias divers et variés, alliant originalité artistique et narration visuelle cinématographique.">

        <meta name="twitter:title" content="MetamorphoseFilm">
        <meta name="twitter:description" content="Société de production audiovisuelle créative, Metamorphose conçoit des contenus multimédias divers et variés, alliant originalité artistique et narration visuelle cinématographique.">

        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "Metamorphose Film",
          "author": {
            "@type": "Organization",
            "name": "Metamorphose Film"
          },
          "url": "https://metamorphosefilm.com",
          "description": "Société de production audiovisuelle créative.",
          "datePublished": "2024-11-02T12:00:00Z"
        }
        </script>
        {% endblock %}

        <title>{% block title %}{% endblock %} - Metamorphose Film</title>

        <link rel="icon" href="https://metamorphosefilm.com/favicon.ico" type="image/x-icon">
        <link rel="icon" type="image/x-icon" sizes="192x192" href="https://metamorphosefilm.com/favicon.ico">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/manifest.json">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% include "_partials/_header.html.twig" %}
        {% block body %}{% endblock %}
        {% include "_partials/cookie.html.twig" %}
    </body>
</html>