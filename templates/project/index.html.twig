{% extends 'base.html.twig' %}

{% block title %}{{project.name}}{% endblock %}

{% block meta %}
    {# <meta name="turbo-cache-control" content="no-cache"> #}
{% endblock %}

{% block body %}

    <main class="single-project" data-controller="singleProject">
        <article>
            <div>
                {% if next %}
                    <a aria-label="Aller au prochain projet" href="/projet/{{next}}"  class="single-project-fixed-btn single-project-nextBtn">></a>
                {% endif %}

                {% if prev %}
                    <a aria-label="Aller au projet precedent" href="/projet/{{prev}}"  class="single-project-fixed-btn single-project-prevBtn"><</a>
                {% endif %}
            </div>
           
            <video src="{{asset("/uploads/videos/" ~ project.backgroundVideo)}}" width="100%" height="100%" autoplay muted loop playsinline preload="none"></video>
            <h1>{{project.name}}</h1>

            <div class="madeBy">
                <h2>Realisé par</h2>
                <ul>
                    {% for item in project?.madeBy|split(',') %}
                        <li>{{item}}</li>
                    {% endfor %}
                </ul>
            </div>
             
                {% if cookie is defined  %}
                    {% if cookie == '' or cookie == 'false' %}
                     {% set videoId = project.youtubeVideo|split('=')[1]|split('&')[0] %}
                     <div class="ytb-video-container ytb-video-container-no-cookie">
                            <div class="video-blocker" data-video-id="{{videoId}}">
                                <img src="https://i.ytimg.com/vi/{{videoId}}/maxresdefault.jpg" alt="image cover {{project.name}}" class="video-cover">
                                <div class="video-title-wrapper">
                                    <span class="video-title">{{project.name}}</span>
                                </div>
                                <div class="play-btn">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="#ffffff">
                                        <path d="M8 5v14l11-7z"/>
                                    </svg>
                                </div>
                                <span class="youtube-label">YouTube</span>
                            </div>
                        </div>
                        {% elseif cookie == 'true' %}
                            <div class="ytb-video-container">
                                <iframe width="560" height="315" src="{{project.youtubeVideo|replace({'watch?v=' : 'embed/'})|split('&')[0]}}?autoplay=1&mute=1" allowfullscreen data-poster=""></iframe>
                            </div>
                        {% endif %}
                    
                {% endif %}
               
            </div>

            <div class="project-assets">
                <div class="project-images">
                    {% for image in images %}
                        <img src="/uploads/images/projects/{{image.src}}" alt="" width="300">
                    {% endfor %}
                </div>

                <div class="project-staff">
                    <twig:StaffItem title="Production" staffType="{{staff.production ?? ""}}"/>
                    <twig:StaffItem title="Artiste" staffType="{{staff.artists ?? ""}}"/>
                    <twig:StaffItem title="Montage" staffType="{{staff.montage ?? ""}}"/>
                    <twig:StaffItem title="Cadrage" staffType="{{staff.cadrage ?? ""}}"/>
                    <twig:StaffItem title="Pilote de drone" staffType="{{staff.droniste ?? ""}}"/>
                    <twig:StaffItem title="Photographe de plateau" staffType="{{staff.phPlateau ?? ""}}"/>
                    <twig:StaffItem title="Chef Opérateur" staffType="{{staff.decorateurs ?? ""}}"/>
                    
                    {% for row in createdStaff %}
                        <twig:StaffItem title="{{row.value1 ?? ""}}" staffType="{{row.value2 ?? ""}}"/>
                    {% endfor %} 
                </div>             
            </div>
        </article>
    </main>

{% endblock %}

 
