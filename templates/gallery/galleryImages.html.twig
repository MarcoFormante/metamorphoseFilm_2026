{% extends 'base.html.twig' %}

{% block title %}Galerie Concert{% endblock %}

{% block body %}
<main class="gallery-images" data-controller="galleryImages">
    <twig:backBtn href="/galerie" />
    <twig:pageTitle title1="Galerie" title2="{{name|capitalize}}" />
    <div class="image-list">
        {% for image in images %}
            <img class="gallery-img" src="{{asset('/uploads/images/galleries/' ~ image.src)}}" alt="" width="360" height="546"/>
        {% endfor %}
    </div>

    <div class="show-gallery">
        <img src="" alt="">
        <button class="show-gallery-exit">x</button>
        <button class="show-gallery-btn show-gallery-btn-right">></button>
        <button class="show-gallery-btn show-gallery-btn-left"><</button>
    </div>
   
</main>
{% endblock body%}

