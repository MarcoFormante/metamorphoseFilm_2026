{% extends 'base.html.twig' %}

{% block title %}Galerie {{ name }}{% endblock %}

{% block meta %}
    {% set galleryTitle = "Galerie " ~ name|capitalize %}
    {% set pageDescription = "Découvrez l'album photo " ~ name|capitalize ~ " par Métamorphose Film. Explorez nos captures artistiques et réalisations visuelles." %}

    <!-- SEO Specifico della pagina -->
    <meta name="description" content="{{ pageDescription }}">
    <meta name="keywords" content="galerie photo {{ name }}, album photo {{ name }}, shooting {{ name }}, photographie d'art, portfolio metamorphose">
    <meta name="robots" content="index, follow">

    <!-- Open Graph Specifico -->
    <meta property="og:title" content="{{ galleryTitle }} - Metamorphose Film">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ app.request.getUri() }}">
    <meta property="og:description" content="{{ pageDescription }}">

    <!-- Twitter Specifico -->
    <meta name="twitter:title" content="{{ galleryTitle }} - Metamorphose Film">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <!-- Dati Strutturati per la Galleria Immagini -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ImageGallery",
      "name": "{{ galleryTitle }}",
      "description": "{{ pageDescription }}",
      "url": "{{ app.request.getUri() }}",
      "provider": {
        "@type": "Organization",
        "name": "Metamorphose Film"
      }
    }
    </script>
{% endblock %}

{% block body %}
<main class="gallery-images" data-controller="galleryImages">
    <twig:backBtn href="/galerie" />
    <twig:pageTitle title1="Galerie" title2="{{ name|capitalize }}" />
        <div class="image-list">
            {% for image in images %}
                <img data-description="{{image.description}}" class="gallery-img" src="{{ asset('/uploads/images/galleries/' ~ image.src) }}" alt="Photo {{loop.index}} de la galerie {{ name|capitalize }}. {{image.description}}" width="360" height="546"/>
            {% endfor %}
        </div>

    <div class="show-gallery flex-col">
        <img src="" alt="">
        <div class="image-desc-container">
            <p class="img-desc"></p>
        </div>
        
        <button aria-label="fermer" class="show-gallery-exit">
            <svg 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <button aria-label="suivant" class="show-gallery-btn show-gallery-btn-right">></button>
        <button aria-label="arriere" class="show-gallery-btn show-gallery-btn-left"><</button>
    </div>
</main>
{% endblock %}