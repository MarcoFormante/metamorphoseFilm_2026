{% extends 'base.html.twig' %}

{% block title %}Galerie {{name}}{% endblock %}

{% block body %}
<main class="gallery-images" data-controller="galleryImages">
    <twig:backBtn href="/galerie" />
    <twig:pageTitle title1="Galerie" title2="{{name|capitalize}}" />
    <div class="image-list">
        {% for image in images %}
            <img class="gallery-img" src="{{asset('/uploads/images/galleries/' ~ image.src)}}" alt="" width="360" height="546"/>
        {% endfor %}
    </div>

    <div class="show-gallery">
        <img src="" alt="">
        <button aria-label="fermer" class="show-gallery-exit">
            <svg 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <button aria-label="suivant" class="show-gallery-btn show-gallery-btn-right">></button>
        <button aria-label="arriere" class="show-gallery-btn show-gallery-btn-left"><</button>
    </div>
   
</main>
{% endblock body%}

