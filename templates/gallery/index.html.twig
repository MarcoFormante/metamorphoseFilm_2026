{% extends 'base.html.twig' %}

{% block title %}Galerie{% endblock %}
{% set pageDescription = "Explorez les galeries photos et réalisations visuelles de Métamorphose Film. Découvrez nos projets à travers notre portfolio artistique." %}
{% block meta %}
    
    <meta name="description" content="{{ pageDescription }}">
    <meta name="robots" content="index, follow">

    <meta property="og:title" content="Galerie Photo &amp; Portfolio - Metamorphose Film">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:description" content="{{ pageDescription }}">

    <meta name="twitter:title" content="Galerie Photo &amp; Portfolio - Metamorphose Film">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Galerie Photo - Metamorphose Film",
      "description": {{ pageDescription|json_encode|raw }},
      "url": {{ canonicalUrl|json_encode|raw }},
      "about": {
        "@type": "Organization",
        "name": "Metamorphose Film"
      }
    }
    </script>
{% endblock %}

{% block body %}
<main class="galleries">
    <h1 class="hidden">Galerie photo - Metamorphose Film</h1>
    <ul class="gallery-list">
        {% if galleries %}
            {% for gallery in galleries %}
                <li>
                    <a href="/galerie/{{ gallery.name|lower|url_encode }}">
                        <figure>
                            <img src="{{ asset('/uploads/images/gallery/' ~ gallery.src) }}" alt="Galerie d'images, catégorie {{ gallery.name }}" width="300" height="420">
                            <figcaption>{{ gallery.name|capitalize }}</figcaption>
                        </figure>
                    </a>
                </li>
            {% endfor %}
        {% endif %}
    </ul>
</main>
{% endblock %}