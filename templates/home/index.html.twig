{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
   <main class="fixed-main">
    <h1 class="hidden">Metamorphose Film — Découvrir nos projets</h1>
        <div class="swiper" data-controller="swiper">
            <div class="swiper-wrapper">
                {% for project in projects %}
                    <twig:Swiperitem :src="project.backgroundVideo" :slug="project.getSlug" :title="project.getName" :collab="project.collabWith|replace({'&amp;' : '&'})" :poster="project.thumb" />
                {% endfor %}
            </div>
        </div>
   </main>
{% endblock %}

