{% extends 'base.html.twig' %}

{% block title %}Services{% endblock %}

{% block meta %}
    {% set pageDescription = "Production audiovisuelle sur mesure : Publicitaire, Corporate, Événementiel et Clip Vidéo. Découvrez notre processus de réalisation de la préproduction à la distribution." %}

    <meta name="description" content="{{ pageDescription }}">
    <meta name="keywords" content="production publicitaire, vidéo corporate, film entreprise, captation événementiel, réalisation clip vidéo, préproduction, tournage, montage, metamorphose film">
    <meta name="robots" content="index, follow">

    <meta property="og:title" content="Nos Services de Production Audiovisuelle - Metamorphose Film">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.getUri() }}">
    <meta property="og:description" content="{{ pageDescription }}">

    <meta name="twitter:title" content="Nos Services de Production Audiovisuelle - Metamorphose Film">
    <meta name="twitter:description" content="{{ pageDescription }}">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Production Audiovisuelle et Réalisation Cinématographique",
      "provider": {
        "@type": "Organization",
        "name": "Metamorphose Film",
        "url": "https://metamorphosefilm.com"
      },
      "description": "{{ pageDescription }}",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Catalogue de Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Publicitaire"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Corporate"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Événementiel"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Clip Vidéo"
            }
          }
        ]
      }
    }
    </script>
{% endblock %}

{% block body %}
<main class="services main-padding title-mobile-center">
    <article>
        <twig:pageTitle title1="Services" title2="" />

        <h2>Nos types de projets :</h2>
        <ul class="services-cards-projects-section">
            <li>
                <a href="/services/publicitaire" title="Visiter le service PUBLICITAIRE">PUBLICITAIRE</a>
            </li>
            <li>
                <a href="/services/corporate" title="Visiter le service CORPORATE">CORPORATE</a>
            </li>
            <li>
                <a href="/services/evenementiel" title="Visiter le service ÉVÉNEMENTIEL">ÉVÉNEMENTIEL</a>
            </li>
            <li>
                <a href="/services/clip-video" title="Visiter le service CLIP VIDÉO">CLIP VIDÉO</a>
            </li>
        </ul>
        
        <h3>Comment se déroule la réalisation d'un projet ?</h3>

        <ul class="cards-list" data-controller="cards">
            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <h4>1. Préproduction</h4>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <h5>Concept et Planification</h5>
                            <ul>
                                <li>Développer l'idée</li>
                                <li>Storyboard</li>
                                <li>Budget et Planning</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>

            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <h4>2. Production</h4>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <h5>Tournage</h5>
                            <ul>
                                <li>Installation du matériel</li>
                                <li>Filmer les scènes</li>
                                <li>Direction artistique</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>

            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn"> 
                    <div class="card-flipper">
                        <div class="card-front">
                            <h4>3. Postproduction</h4>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <h5>Montage / Édition</h5>
                            <ul>
                                <li>Dérushage et Assemblage</li>
                                <li>Étalonnage</li>
                                <li>Effets spéciaux, Graphismes</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>

            <li class="card-container">
                <button aria-pressed="false" aria-expanded="false" class="card-btn">
                    <div class="card-flipper">
                        <div class="card-front">
                            <h4>4. Distribution</h4>
                        </div>
                        <div class="card-back" aria-hidden="true">
                            <h5>Publication / Promotion</h5>
                            <ul>
                                <li>Choisir les plateformes</li>
                                <li>Télécharger et optimiser</li>
                                <li>Marketing</li>
                            </ul>
                        </div>
                    </div>
                </button>
            </li>
        </ul>
        
        <a class="services-email" href="mailto:metamorphoseproductions@gmail.com">metamorphoseproductions@gmail.com</a>
    </article>
</main>
{% endblock %}